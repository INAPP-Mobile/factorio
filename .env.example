# ── Factorio Headless Server — environment variables ──────────────────────────
# Copy this file to .env, fill in the values you want, and import via
# `railway variables set --from-file .env` or paste into the Railway dashboard.
#
# These map to the upstream image's env vars (factoriotools/factorio). The
# upstream entrypoint at /docker-entrypoint.sh reads most of them directly.

# ── Save selection ───────────────────────────────────────────────────────────
# Set to a save name (without .zip) under /factorio/saves to load a specific
# save. If SAVE_NAME is empty and LOAD_LATEST_SAVE=true (default), the
# server loads the most recent save in /factorio/saves.
# SAVE_NAME=

# LOAD_LATEST_SAVE=true loads the most recent save (default).
# LOAD_LATEST_SAVE=false requires SAVE_NAME to be set; if not, the server
# refuses to start.
LOAD_LATEST_SAVE=true

# GENERATE_NEW_SAVE=true creates a new save named after the current ISO
# timestamp. Use this once and then set SAVE_NAME to load the result on
# subsequent boots.
GENERATE_NEW_SAVE=false

# ── Server identity (written into server-settings.json on first boot) ────────
# The upstream image copies data/server-settings.example.json to
# /factorio/config/server-settings.json on first boot. To customize, edit
# the JSON file directly via the volume (after first deploy), or rebuild the
# image with a baked-in server-settings.json.

# ── RCON (admin) ─────────────────────────────────────────────────────────────
# The upstream entrypoint generates a random RCON password on first boot and
# writes it to /factorio/config/rconpw. To use a fixed password, ssh into
# the volume and overwrite rconpw before the server starts reading it.
# Recommended: leave it auto-generated and read the file via the volume.

# ── Gameplay flags ───────────────────────────────────────────────────────────
# true = pause the world when no players are online (saves CPU)
# false = world keeps ticking 24/7
# AUTO_PAUSE=true

# Seconds between autosaves (game default 300 = 5 min)
# AUTOSAVE_INTERVAL=300

# ── Network ──────────────────────────────────────────────────────────────────
# Default game port is 34197/udp, RCON 27015/tcp. Railway's port detection
# picks these up automatically because they're in the upstream Dockerfile's
# EXPOSE line.

# ── Mods ─────────────────────────────────────────────────────────────────────
# UPDATE_MODS_ON_START=true runs /docker-update-mods.sh on every boot to
# download the latest mod versions listed in /factorio/mods/mod-list.json.
# Set to false to keep the current mod set pinned.
# UPDATE_MODS_ON_START=false
